<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net4.8</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Libs Include="libs_323\*.dll" Exclude="libs_323\System.*.dll" />

    <Reference Include="@(Libs)">
      <HintPath>%(Libs.FullPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="src\**\*.cs" />
    <None Include="src\**\*.cs" />
    <Compile Remove="og_src\**\*.cs" />
    <None Include="og_src\**\*.cs" />
    <Compile Remove="toasterperformance_src\**\*.cs" />
    <None Include="toasterperformance_src\**\*.cs" />
    <Compile Remove="B323 Server Side Fixes\**\*.cs" />
    <None Include="B323 Server Side Fixes\**\*.cs" />
  </ItemGroup>

  <Target Name="PostBuildMoveDll" AfterTargets="Build">
    <PropertyGroup>
      <TargetDir>F:\Steam\steamapps\common\Puck\Plugins\ToasterPerformance</TargetDir>
    </PropertyGroup>

    <MakeDir Directories="$(TargetDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(TargetDir)" OverwriteReadOnlyFiles="true" />

    <Message Importance="high" Text="Copied $(AssemblyName).dll to $(TargetDir)" />
  </Target>

</Project>
